# Default is honest simulation. No actual API request or translation occurs.
TRANSLATION_MODE=mock
DATABASE_PATH=.data/workbench.sqlite
PORT=3001
TRANSLATION_TIMEOUT_MS=3000
# Optional explicit allowed browser origin (loopback single-user use only).
# APP_ORIGIN=http://127.0.0.1:3001
# Real service is intentionally opt-in; keep all credentials on the server.
# TRANSLATION_MODE=real
# ALLOW_REAL_TRANSLATION=true
# TRANSLATION_API_URL=https://your-provider.example/v1/chat/completions
# TRANSLATION_MODEL=your-model
# TRANSLATION_API_KEY=
# The server does not auto-load .env; export variables in your shell/process manager.
