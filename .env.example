# Default is honest simulation; startup/settings never connect to a provider.
DATABASE_PATH=.data/workbench.sqlite
PORT=3001
TRANSLATION_TIMEOUT_MS=30000
# APP_ORIGIN=http://127.0.0.1:3001
# Optional future operator gates. Keep CLOSED during offline development/tests.
ALLOW_REAL_TRANSLATION=false
TRANSLATION_MAX_BUDGET_USD=0
# Choose official protocol/model and credential VARIABLE REFERENCE in the UI.
# Future service process credential: OPENAI_API_KEY (value must come from a safe runtime).
# Do not paste a key here, in a browser, logs or chat; no real value in this example.
# Browser explicit consent is additionally required; arming never sends a request.
# This is a cumulative test ledger, not an absolute provider billing guarantee.
# The currently approved first trial total is USD1, not a permanent per-document limit.
# This server does not auto-load .env. Existing legacy TRANSLATION_MODE/URL/MODEL
# variables do not activate the new runtime or a custom endpoint transport.
